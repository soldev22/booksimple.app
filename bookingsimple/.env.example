COSMOS_DB_ENDPOINT=
COSMOS_AUTH_MODE=azure-cli
# For local development only, set COSMOS_AUTH_MODE=key and supply this server-side key.
COSMOS_DB_KEY=

# Required only when running the explicit auth database provisioning command.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Required when COSMOS_AUTH_MODE is vercel-oidc.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Exact public origin used for same-origin API checks and email links.
APP_ORIGIN=

# PAYMENT_PROVIDER defaults to MOCK_TEST. Set STRIPE only after configuring the
# matching server-side key and Connect webhook signing secret.
PAYMENT_PROVIDER=MOCK_TEST
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Stage 13 supports only the explicitly simulated provider. Real channel
# providers are selected and configured in later stages.
MESSAGING_PROVIDER=MOCK_TEST

# Generate each value independently with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_MFA_ENCRYPTION_KEY=
AUTH_NOTIFICATION_ENCRYPTION_KEY=

# Postmark server-side credentials. Use a verified sender address.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound

# Required only when intentionally running the one-time bootstrap CLI.
PLATFORM_BOOTSTRAP_SETUP_TOKEN=
